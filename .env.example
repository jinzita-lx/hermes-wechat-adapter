ADAPTER_HOST=0.0.0.0
ADAPTER_PORT=8787
ADAPTER_AUTH_TOKEN=replace-with-a-random-token
PUBLIC_BASE_URL=

HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=replace-with-hermes-api-key
HERMES_MODEL=hermes-agent
HERMES_RESTRICTED_API_BASE_URL=http://127.0.0.1:8643/v1
HERMES_RESTRICTED_API_KEY=replace-with-hermes-restricted-api-key
HERMES_RESTRICTED_MODEL=hermes-agent

WECHAT_DM_POLICY=open
WECHAT_ALLOWED_CONTACTS=
WECHAT_ADMIN_USERS=
WECHAT_GROUP_POLICY=disabled
WECHAT_ALLOWED_ROOMS=
WECHAT_REQUIRE_MENTION_IN_GROUPS=true
WECHAT_ACTIVATION_PREFIXES=Hermes,小H,/hermes
BOT_ALIAS=Hermes

WECHAT_BRIDGE_MODE=dual
WECHAT_DEFAULT_PROVIDER=gewechat
WECHAT_FALLBACK_PROVIDER=windows_sidecar
WECHAT_DEDUPE_WINDOW_SECONDS=60

GEWECHAT_ENABLED=true
GEWECHAT_TRANSPORT=webhook
GEWECHAT_WEBHOOK_ENABLED=true
GEWECHAT_WEBSOCKET_ENABLED=false

WINDOWS_SIDECAR_ENABLED=true
WINDOWS_SIDECAR_TRANSPORT=websocket
WINDOWS_SIDECAR_WEBHOOK_ENABLED=false
WINDOWS_SIDECAR_WEBSOCKET_ENABLED=true

GEWECHAT_API_BASE_URL=http://127.0.0.1:2531/v2/api
GEWECHAT_TOKEN=
GEWECHAT_APP_ID=
GEWECHAT_CALLBACK_URL=

REPLY_CHUNK_SIZE=1800
MAX_UPLOAD_BYTES=52428800
DATA_DIR=/root/hermes-wechat-adapter/data
FILES_DIR=/root/hermes-wechat-adapter/data/files
COMMAND_POLL_TIMEOUT_MS=25000
HERMES_INSTRUCTIONS_EXTRA=
